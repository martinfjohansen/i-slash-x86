Bgs RdrandGuaranteedS
  u64 n
  b1 c
  b1 tb10
Ens

Fnc RdrandGuaranteed
  Mov c, 0
  Loop
  If exp b: c = 0
    Rdrand n, c
  EndLoop
Ret

Bgs ToUpperILS
  u8x32a str
  exp decl: u64 len, len32, len1, i
  b1 tb10
  exp decl: u8x32 a, z, x32, x, lcm, padding
  exp decl: b8x32 tb8x320, tb8x321, tb8x322
Ens

Fnc ToUpperIL
  Len len, str
  Div len32, len, 32

  Mov a, 'a'
  Mov z, 'z'
  Mov x32, 32

  Mov i, 0
  Loop
  If exp b: i < len32
    Idr x, str, i

    exp b b8x32: lcm = (x >= a & x <= z) & x32
    exp a u8x32: x = x - lcm

    Idw str, i, x

    Inc i
  EndLoop
Ret

