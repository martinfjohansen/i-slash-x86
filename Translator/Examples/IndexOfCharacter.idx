Bgs IndexOfCharacterAS
	exp decl: u64 i, len, xlen, index, zcnt, tu640, tu641
	exp decl: u16 c, x
	u16a str
	exp decl: b1 found, tb10, tb11
	u8x16a stra
	u8x16 sc
	u16x8 ccx
	u8x16 cc
	b16 mask1
Ens

Fnc IndexOfCharacterA
	Xu8x16a stra, str
	Broadcast ccx, c
	Xu8x16 cc, ccx

	exp a u64: xlen = len / 8

	Loop
	If exp b: i < xlen & !found
	
		Idr sc, stra, i
		
		FindSubstring mask1, sc, 16, cc, 2
		Lzcnt zcnt, mask1
		
		If exp b: zcnt != 16
			Mov found, true
			exp a u64: index = i * 8 + (16 - zcnt)/2
		Endb

		Inc i
	EndLoop
	
	exp a u64: i = xlen * 8

Ret



