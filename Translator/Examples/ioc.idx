Bgs NumberReference
  u64 numberValue
Ens

Bgs IndexOfCharacterS
  u32a string
  u32 character
  u32 c
  str NumberReference indexReference
  u8 retval
  u64 i
  exp decl: b1 found, tb10, tb11, tb12
  u64 len
Ens

Fnc IndexOfCharacter
  Mov found, false
  Mov i, 0
  Loop
    Len len, string
  If exp b: i < len & !found
    Idr c, string, i
    If exp b: c = character
      Mov found, true
      Acw indexReference, numberValue, i
    Endb
    Inc i
  EndLoop
  Xu8 retval, found
Ret
