; -----------------------------------------------------------------------------
; Acw -- Structure write element
; x.y = a. x must be a structure type. a and y must be of the same types.

%macro Acw.mmu16 3
  mov ax, word [rdi + %3]
  mov rdx, qword [rdi + %1]
  mov word [rdx + %2], ax
%endmacro

%macro Acw.mmu64 3
  mov rax, qword [rdi + %3]
  mov rdx, qword [rdi + %1]
  mov qword [rdx + %2], rax
%endmacro

