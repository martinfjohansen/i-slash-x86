; -----------------------------------------------------------------------------
; Call
; f(x). x must be a structure.

%macro Call 2
  push rdi
  mov rdi, [rdi + %2]
  call %1
  pop rdi
%endmacro

; -----------------------------------------------------------------------------
; Else
; No parameters

%macro Else 2
  jmp %2
  %1:
%endmacro

; -----------------------------------------------------------------------------
; New
; x = New(S). The type of x must be S.

extern malloc

%macro New 2
  push rdi
  push rdi
  mov rdi, %2_size
  call malloc
  pop rdi
  pop rdi
  mov [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Del
; Del(x).

extern free

%macro Del.mstr 1
  push rdi
  push rdi
  mov rdi, [rdi + %1]
  call free
  pop rdi
  pop rdi
%endmacro

