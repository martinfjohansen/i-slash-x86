; Could have used comiss
%macro Eq.mif32 3
  movss xmm0, [rdi + %2]
  mov eax, __?float32?__(%3)
  movd xmm1, eax
  cmpeqss xmm0, xmm1
  movd eax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Eq.mif64 3
  movsd xmm0, [rdi + %2]
  mov rax, __?float64?__(%3)
  movq xmm1, rax
  cmpeqsd xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

