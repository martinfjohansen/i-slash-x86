  mov rdx, 0
  mov rcx, qword [rdi + %3]
  div rcx
  mov qword [rdi + %1], rax
%endmacro

%macro Div.mms8 3
  mov ax, 0
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  idiv dl
  mov byte [rdi + %1], al
%endmacro

%macro Div.mms16 3
  mov ax, word [rdi + %2]
  mov dx, 0
  mov cx, word [rdi + %3]
  idiv cx
  mov word [rdi + %1], ax
%endmacro

%macro Div.mms32 3
  mov eax, dword [rdi + %2]
  mov edx, 0
  mov ecx, dword [rdi + %3]
  idiv ecx
  mov dword [rdi + %1], eax
%endmacro

%macro Div.mms64 3
  mov rax, qword [rdi + %2]
  mov rdx, 0
  mov rcx, qword [rdi + %3]
  idiv rcx
  mov qword [rdi + %1], rax
%endmacro

%macro Div.mmf32 3
  movss xmm0, [rdi + %2]
  divss xmm0, [rdi + %3]
  movss [rdi + %1], xmm0
%endmacro

%macro Div.mmf64 3
  movsd xmm0, [rdi + %2]
  divsd xmm0, [rdi + %3]
  movsd [rdi + %1], xmm0
%endmacro

