; -----------------------------------------------------------------------------
; MulFull -- Multiply two x-bit numbers and store the full 2x-bit result
; x = a op b. a and b of x-bit. x of 2x-bit.

%macro MulFull.mmu8 3
  mov al, byte [rdi + %2]
  mov cl, byte [rdi + %3]
  mul cl
  mov word [rdi + %1], ax
%endmacro

%macro MulFull.mms64 3
  mov eax, dword [rdi + %2]
  mov ecx, dword [rdi + %3]
  imul ecx
  shl rdx, 32
  or rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro MulFull.mms128 3
  mov rax, qword [rdi + %2]
  mov rcx, qword [rdi + %3]
  imul rcx
  mov qword [rdi + %1], rax
  mov qword [rdi + %1 + 8], rdx
%endmacro

%macro MulFull.mmu64x2 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  pmuludq xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Div
; x = a / b. x, a and b of the same type.

; v0.1

%macro Div.mmu8 3
  mov ax, 0
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  div dl
  mov byte [rdi + %1], al
%endmacro

%macro Div.mmu16 3
  mov ax, word [rdi + %2]
  mov dx, 0
  mov cx, word [rdi + %3]
  div cx
  mov word [rdi + %1], ax
%endmacro

%macro Div.mmu32 3
  mov eax, dword [rdi + %2]
  mov edx, 0
  mov ecx, dword [rdi + %3]
  div ecx
  mov dword [rdi + %1], eax
%endmacro

%macro Div.mmu64 3
