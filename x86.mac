  mov dl, %3
  cmp al, dl
  setne al
  mov byte [rdi + %1], al
%endmacro

%macro Neq.mmb256 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
