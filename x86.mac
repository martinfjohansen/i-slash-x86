  lea rax, [rax + %2 * 8]
  mov rcx, qword [rdi + %3]
  mov qword [rax], rcx
%endmacro

%macro Idw.imu16x8a 3
  movdqu xmm0, oword [rdi + %3]
  mov rax, qword [rdi + %1]
  movdqu oword [rax + %2 * 16], xmm0
%endmacro

%macro Idw.ims16x8a 3
  movdqu xmm0, oword [rdi + %3]
  mov rax, qword [rdi + %1]
  movdqu oword [rax + %2 * 16], xmm0
%endmacro

%macro Idw.imb16x8a 3
  movdqu xmm0, oword [rdi + %3]
  mov rax, qword [rdi + %1]
  movdqu oword [rax + %2 * 16], xmm0
%endmacro

%macro Idw.imu16x8 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, 0
  mov ax, word [rdi + %3]
  vpinsrw xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.ims16x8 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, 0
  mov ax, word [rdi + %3]
  vpinsrw xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.imb16x8 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, 0
  mov ax, word [rdi + %3]
  vpinsrw xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro





; Future

%macro Idw.iiu16a 3
  mov rcx, %2
  mov rax, [rdi + %1]
  lea rax, [rax + rcx * 2]
  mov cx, %3
  mov word [rax], cx
%endmacro

%macro Idw.mmu8x32a 3
  vmovdqu ymm0, yword [rdi + %3]
  mov rax, qword [rdi + %1]
  mov rcx, qword [rdi + %2]
  shl rcx, 5
  vmovdqu yword [rax + rcx], ymm0
%endmacro

%macro Idw.mmu8x16a 3
  movdqu xmm0, oword [rdi + %3]
  mov rax, qword [rdi + %1]
  mov rcx, qword [rdi + %2]
  shl rcx, 4
  movdqu oword [rax + rcx], xmm0
%endmacro

%macro Idw.mmu32x4a 3
  movdqu xmm0, oword [rdi + %3]
  mov rax, qword [rdi + %1]
  mov rcx, qword [rdi + %2]
  shl rcx, 4
  movdqu oword [rax + rcx], xmm0
%endmacro

%macro Idw.imu32x4a 3
  movdqu xmm0, oword [rdi + %3]
  mov rax, qword [rdi + %1]
  mov rcx, %2
  shl rcx, 4
  movdqu oword [rax + rcx], xmm0
%endmacro

%macro Idw.mru8x32a 3
  mov rax, qword [rdi + %1]
  mov rcx, qword [rdi + %2]
  shl rcx, 5
  vmovdqu yword [rax + rcx], %3
%endmacro

%macro Idw.mrru8x32a 3
  mov rax, qword [rdi + %1]
  mov rcx, %2
  shl rcx, 5
  vmovdqu yword [rax + rcx], %3
%endmacro

%macro Idw.rrru8x32a 3
  mov rcx, %2
  shl rcx, 5
  vmovdqu yword [%1 + rcx], %3
%endmacro

%macro Idw.iiu8x16 3
  movdqu xmm0, oword [rdi + %1]
  mov al, %3
  vpinsrb xmm0, al, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.iis8x16 3
  movdqu xmm0, oword [rdi + %1]
  mov al, %3
  vpinsrb xmm0, al, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.miu8x16 3
  movdqu xmm0, oword [rdi + %1]
  mov al, byte [rdi + %3]
  vpinsrb xmm0, al, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.iiu16x8 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, %3
  vpinsrw xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.iis16x8 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, %3
  vpinsrw xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.iis32x4 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, %3
  vpinsrd xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.imu32x4 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, dword [rdi + %3]
  vpinsrd xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.iiu32x4 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, %3
  vpinsrd xmm0, eax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.imf32x4 3
  movdqu xmm0, oword [rdi + %1]
  movd xmm1, dword [rdi + %3]
  insertps xmm0, xmm1, %2 << 4
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.imf64x8 3
  vmovdqu64 zmm0, zword [rdi + %1]
  vmovq xmm1, qword [rdi + %3]
  mov eax, 1 << %2
  kmovw k1, eax
  vbroadcastsd zmm0 {k1}, xmm1
  vmovdqu64 zword [rdi + %1], zmm0
%endmacro

%macro Idw.iif32x4 3
  movdqu xmm0, oword [rdi + %1]
  mov eax, __?float32?__(%3)
  movq xmm1, rax
  insertps xmm0, xmm1, %2 << 4
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.iif64x2 3
  movdqu xmm0, oword [rdi + %1]
  mov rax, __?float64?__(%3)
  vpinsrq xmm0, rax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Idw.iiu32x8 3
  vmovdqu ymm0, yword [rdi + %1]
  vextracti128 xmm1, ymm0, %3 / 8
  mov eax, %3
  vpinsrd xmm1, eax, %2 % 8
  vinserti128 ymm0, xmm1, %3 / 8
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Idw.iiu64x2 3
  movdqu xmm0, oword [rdi + %1]
  mov rax, %3
  vpinsrq xmm0, rax, %2
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Rdrand
; x = Rdrand(). x must be a number type

%macro Rdrand.mu64 2
  rdrand rax
  mov qword [rdi + %1], rax
  setc byte [rdi + %2]
%endmacro

; -----------------------------------------------------------------------------
; Set
; x = SetIf(a). The setcc instruction works with a flag as an input.

%macro Set.mu64 2
  mov al, byte [rdi + %2]
  cmp al, 0
  setne al
  movzx rax, al
  mov qword [rdi + %1], rax
%endmacro

%macro Set.ms64 2
  mov al, byte [rdi + %2]
  cmp al, 0
  setne al
  movzx rax, al
  mov qword [rdi + %1], rax
%endmacro

