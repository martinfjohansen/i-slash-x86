%endmacro

%macro Inc.mf32 1
  movss xmm0, dword [rdi + %1]
  mov eax, 1
  cvtsi2ss xmm1, eax
  addss xmm0, xmm1
  movss dword [rdi + %1], xmm0
%endmacro

%macro Inc.mf64 1
