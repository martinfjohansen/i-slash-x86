%endmacro

%macro Acr.mmf64 3
  mov rax, [rdi + %2]
  mov rax, [rax + %3]
  mov [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Inc -- Increment by 1
; x++. x must be a number type.

; v0.1

%macro Inc.mu8 1
