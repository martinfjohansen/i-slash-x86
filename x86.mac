  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  movdqu xmm2, xmm1
  pcmpgtw xmm1, xmm0
  pcmpeqw xmm2, xmm0
  por xmm1, xmm2
  movdqu oword [rdi + %1], xmm1
%endmacro

