; -----------------------------------------------------------------------------
; Eq -- Equal
; x = a = b. x is a boolean. a and b are the same types.

; v0.1

%macro Eq.mmb1u8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  cmp al, dl
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1u16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  cmp ax, dx
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1u32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  cmp eax, edx
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1u64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  cmp rax, rdx
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1s8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  cmp al, dl
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1s16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  cmp ax, dx
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1s32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  cmp eax, edx
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1s64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  cmp rax, rdx
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1f32 3
  movss xmm0, [rdi + %2]
  movss xmm1, [rdi + %3]
  cmpeqss xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Eq.mmb1f64 3
  movsd xmm0, [rdi + %2]
  movsd xmm1, [rdi + %3]
  cmpeqsd xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Eq.mmb16x8u16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpcmpeqw xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Eq.mmb16x8s16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpcmpeqw xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Eq.mmb1b1 3
  mov al, byte [rdi + %2]
  and al, 1
  mov dl, byte [rdi + %3]
  and dl, 1
  cmp al, dl
  sete al
  mov byte [rdi + %1], al
%endmacro

%macro Eq.mmb1b8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  cmp al, dl
  sete al
  mov byte [rdi + %1], al
%endmacro

