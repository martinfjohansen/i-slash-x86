; Future


; -----------------------------------------------------------------------------
; Usigned integer to larger unsigned types
; u8tou16, u8tou32, u16tou32, u32tou64
; x = (AtoB)a. a must be of type A, x must be of type B.




; -----------------------------------------------------------------------------
; Usigned integer to larger signed types
; u8tos16, u16tos32, u32tos64
; x = (AtoB)a. a must be of type A, x must be of type B.




; -----------------------------------------------------------------------------
; Signed integer to larger signed types
; s8tos16, s16tos32, s32tos64
; x = (AtoB)a. a must be of type A, x must be of type B.



; -----------------------------------------------------------------------------


; -----------------------------------------------------------------------------
; Integer to floats
; u16tof32, s16tof32, u32tof64, s32tof64
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro u16tof32.m 2
  mov ax, word [rdi + %2]
  movzx eax, ax
  cvtsi2ss xmm0, eax
  movss [rdi + %1], xmm0
%endmacro

%macro s16tof32.m 2
  mov ax, word [rdi + %2]
  movsx eax, ax
  cvtsi2ss xmm0, eax
  movss [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Floats to larger types
; f32tof64
; x = (AtoB)a. a must be of type A, x must be of type B.



; -----------------------------------------------------------------------------
; Usigned integer to smaller unsigned types
; u16tou8, u32tou16, u64tou32
; x = (AtoB)a. a must be of type A, x must be of type B.



; -----------------------------------------------------------------------------
; Usigned integer to smaller unsigned types
; s16tou8, s32tou16, s64tou32
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro s16tou8.m 2
  mov ax, word [rdi + %2]
  mov byte [rdi + %1], al
%endmacro

%macro s32tou16.m 2
  mov eax, dword [rdi + %2]
  mov word [rdi + %1], ax
%endmacro

%macro s64tou32.m 2
  mov rax, qword [rdi + %2]
  mov dword [rdi + %1], eax
%endmacro


; -----------------------------------------------------------------------------
; Signed integer to smaller signed types
; s16tos8, s32tos16, s64tos32
; x = (AtoB)a. a must be of type A, x must be of type B.



; -----------------------------------------------------------------------------
; floats to integers
; f32tou16, f32tos16, f64tou32, f64tos32
; x = (AtoB)a. a must be of type A, x must be of type B.



; -----------------------------------------------------------------------------
; Floats to smaller floats
; f64tof32
; x = (AtoB)a. a must be of type A, x must be of type B.

; -----------------------------------------------------------------------------
; Packed integers to larger types
; u8x8tou16x8, u8x4tou32x4, u8x2tou64x2, u16x4tou32x4, u32x2tou64x2
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro u8x8tou16x8.m 2
  mov rax, qword [rdi + %2]
  movq xmm0, rax
  pmovzxbw xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

%macro u8x4tou32x4.m 2
  mov rax, 0
  mov eax, dword [rdi + %2]
  movq xmm0, rax
  pmovzxbd xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

%macro u8x2tou64x2.m 2
  mov rax, 0
  mov ax, word [rdi + %2]
  movq xmm0, rax
  pmovzxdq xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

%macro u16x4tou32x4.m 2
  movq xmm0, qword [rdi + %2]
  pmovzxwd xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

%macro u32x2tou64x2.m 2
  movq xmm0, qword [rdi + %2]
  pmovzxdq xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

; -----------------------------------------------------------------------------
; Packed signed integers to larger types
; s8x8tos16x8, s8x4tos32x4
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro s8x8tos16x8.m 2
  movq xmm0, qword [rdi + %2]
  pmovsxbw xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

%macro s8x4tos32x4.m 2
  mov rax, 0
  mov eax, dword [rdi + %2]
  movq xmm0, rax
  pmovsxbd xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

; -----------------------------------------------------------------------------
; Packed integers to smaller types
; s64x2tos32x2
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro s64x2tos32x2.m 2
  movq xmm0, qword [rdi + %2]
  vpmovqd xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

; -----------------------------------------------------------------------------
; Packed floats to smaller types
; f64x2tof32x2, f32x4tof16x2
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro f64x2tof32x2.m 2
  movdqu xmm0, oword [rdi + %2]
  cvtpd2ps xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

%macro f32x4tof16x4.m 2
  movdqu xmm0, oword [rdi + %2]
  vcvtps2ph xmm1, xmm0, 0
  movdqu oword [rdi + %1], xmm1
%endmacro

; -----------------------------------------------------------------------------
; Two packed floats downconverted and combined
; f64x4tof32x4, f32x8tof16x8
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro f64x4tof32x4.mm 3
  movdqu xmm0, oword [rdi + %2]
  cvtpd2ps xmm0, xmm0
  movdqu xmm1, oword [rdi + %3]
  cvtpd2ps xmm1, xmm1
  pslldq xmm1, 8
  vpor xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro f32x8tof16x8.mm 3
  movdqu xmm0, oword [rdi + %2]
  vcvtps2ph xmm0, xmm0, 0
  movdqu xmm1, oword [rdi + %3]
  vcvtps2ph xmm1, xmm1, 0
  pslldq xmm1, 8
  vpor xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Packed floating point numbers up-converted and stored in two vars
; f32x4tof64x4
; x = (AtoB)a. a must be of type A, x must be of type B.

; TODO: Can we use vinsertf128?
%macro f32x4tof64x4.mm 3
  movdqu xmm0, oword [rdi + %3]
  movdqu xmm1, xmm0
  cvtps2pd xmm1, xmm1
  movdqu xmm2, xmm0
  psrldq xmm2, 8
  cvtps2pd xmm2, xmm2
  movdqu oword [rdi + %1], xmm1
  movdqu oword [rdi + %2], xmm2
%endmacro

