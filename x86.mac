  mov rdx, qword [rdi + %1]
  mov qword [rdx + %2], rax
%endmacro

%macro Acw.miu64 3
  mov rax, %3
  mov rdx, qword [rdi + %1]
  mov qword [rdx + %2], rax
%endmacro

; -----------------------------------------------------------------------------
; Acr -- Structure read element
; x = a.b. a must be a structure type. x and b must be of the same types.

%macro Acr.mmu64 3
  mov rax, [rdi + %2]
  mov rax, [rax + %3]
  mov [rdi + %1], rax
%endmacro

%macro Acr.mms64 3
  mov rax, [rdi + %2]
  mov rax, [rax + %3]
  mov [rdi + %1], rax
%endmacro

%macro Acr.mmb1 3
  mov rax, [rdi + %2]
