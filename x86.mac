  setne al
  mov byte [rdi + %1], al
%endmacro

%macro Neq.mmb1f32 3
  movss xmm0, [rdi + %2]
  movss xmm1, [rdi + %3]
  cmpness xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Neq.mmb1f64 3
  movsd xmm0, [rdi + %2]
  movsd xmm1, [rdi + %3]
  cmpnesd xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Neq.mmb16x8u16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  pcmpeqw xmm0, xmm1
  pcmpeqd xmm2, xmm2 ; This is a
  pxor xmm0, xmm2    ; not instruction
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Neq.mmb16x8s16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  pcmpeqw xmm0, xmm1
  pcmpeqd xmm2, xmm2 ; This is a
  pxor xmm0, xmm2    ; not instruction
  movdqu oword [rdi + %1], xmm0
%endmacro

