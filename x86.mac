; -----------------------------------------------------------------------------
; Conversion instructions
; x = (AtoB)a. a must be of type A, x must be of type B.

; v0.1

%macro s8tos16.m 2
  mov al, byte [rdi + %2]
  movsx ax, al
  mov word [rdi + %1], ax
%endmacro

%macro s8tos32.m 2
  mov al, byte [rdi + %2]
  movsx eax, al
  mov dword [rdi + %1], eax
%endmacro

%macro s8tos64.m 2
  mov al, byte [rdi + %2]
  movsx rax, al
  mov qword [rdi + %1], rax
%endmacro

%macro s16tos32.m 2
  mov ax, word [rdi + %2]
  movsx eax, ax
  mov dword [rdi + %1], eax
%endmacro

%macro s16tos64.m 2
  mov ax, word [rdi + %2]
  movsx eax, ax
  mov dword [rdi + %1], eax
%endmacro

%macro s32tos64.m 2
  mov eax, dword [rdi + %2]
  movsxd rax, eax
  mov qword [rdi + %1], rax
%endmacro

%macro u8tou16.m 2
  mov al, byte [rdi + %2]
  movzx ax, al
  mov word [rdi + %1], ax
%endmacro

%macro u8tou32.m 2
  mov al, byte [rdi + %2]
  movzx eax, al
  mov dword [rdi + %1], eax
%endmacro

%macro u8tou64.m 2
  mov al, byte [rdi + %2]
  movzx rax, al
  mov qword [rdi + %1], rax
%endmacro

%macro u16tou32.m 2
  mov ax, word [rdi + %2]
  movzx eax, ax
  mov dword [rdi + %1], eax
%endmacro

%macro u16tou64.m 2
  mov ax, word [rdi + %2]
  movzx rax, ax
  mov qword [rdi + %1], rax
%endmacro

; "mov rax, eax" zeroes out the upper part of rax
%macro u32tou64.m 2
  mov eax, dword [rdi + %2]
  mov rax, eax
  mov qword [rdi + %1], rax
%endmacro

