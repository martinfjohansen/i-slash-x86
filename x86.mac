; -----------------------------------------------------------------------------
; StringRangeCheck -- Find members of a range
; x = StringRangeCheck(a, b, l). x, a, b are packed bytes. l is a number.

%macro StringRangeCheck.mmmiu8x16 5
  movdqu xmm1, oword [rdi + %3]
  mov rax, qword [rdi + %4]
  movdqu xmm2, oword [rdi + %2]
  mov rdx, %5
  pcmpestrm xmm1, xmm2, (0 << 6) + (1 << 2)
  vpextrw eax, xmm0, 0
  mov word [rdi + %1], ax
%endmacro

; -----------------------------------------------------------------------------
; MatchString -- Match string
; x = MatchString(a, b, l). x, a, b are packed bytes. l is a number.

%macro MatchString.mmmiu8x16 4
  movdqu xmm1, oword [rdi + %3]
  mov rax, qword [rdi + %4]
  movdqu xmm2, oword [rdi + %2]
  mov rdx, %5
  pcmpestrm xmm1, xmm2, (0 << 6) + (2 << 2)
  vpextrw eax, xmm0, 0
  mov word [rdi + %1], ax
%endmacro

; -----------------------------------------------------------------------------
; FindSubstring -- Locate string
; x = FindSubstring(a, al, b, bl). x, a, b are packed bytes. al, bl are a numbers.

%macro FindSubstring.mmmmu64 5
  movdqu xmm1, oword [rdi + %4]
  mov rax, qword [rdi + %5]
  movdqu xmm2, oword [rdi + %2]
  mov rdx, qword [rdi + %3]
  pcmpestrm xmm1, xmm2, (0 << 6) + (3 << 2)
  vpextrw eax, xmm0, 0
  mov word [rdi + %1], ax
%endmacro

%macro FindSubstring.mimiu64 5
  movdqu xmm1, oword [rdi + %4]
  mov rax, %5
  movdqu xmm2, oword [rdi + %2]
  mov rdx, %3
  pcmpestrm xmm1, xmm2, (0 << 6) + (3 << 2)
  vpextrw eax, xmm0, 0
  mov word [rdi + %1], ax
%endmacro

; -----------------------------------------------------------------------------
; MovAndDuplicate -- Copy data and duplicate even columns
; x = MovAndDuplicate(a). x and a are packed number types.

%macro MovAndDuplicate.mf64x2 2
  movdqu xmm0, oword [rdi + %2]
  movddup xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro MovAndDuplicate.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  movsldup xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; MovAndDuplicateOdd -- Copy data and duplicate odd columns
; x = MovAndDuplicate(a). x and a are packed number types.

%macro MovAndDuplicateOdd.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  movshdup xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro















