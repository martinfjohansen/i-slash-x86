; -----------------------------------------------------------------------------
; MulDiv
; x = a * b / c. x, a, b, c of the same type.

%macro MulDiv.mmu64 4
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  mul rdx
  mov rcx, qword [rdi + %4]
  div rcx
  mov qword [rdi + %1], rax
%endmacro

%macro MulDiv.mms64 4
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  imul rdx
  mov rcx, qword [rdi + %4]
  idiv rcx
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; AddSaturated -- Addition Saturated
; x = a +| b. x, a, b of the same type.

%macro AddSaturated.mms16 3
  mov rax, 0
  mov ax, word [rdi + %2]
  mov rcx, 0
  mov cx, word [rdi + %3]
  movq xmm0, rax
  movq xmm1, rcx
  paddsw xmm0, xmm1
  movq rax, xmm0
  mov word [rdi + %1], ax
%endmacro

%macro AddSaturated.mmu8x16 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpaddusb xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; SubSaturated -- Subtraction Saturated
; x = a -| b. x, a, b of the same type.

%macro SubSaturated.mms16 3
  mov rax, 0
  mov ax, word [rdi + %2]
  mov rcx, 0
  mov cx, word [rdi + %3]
  movq xmm0, rax
  movq xmm1, rcx
  psubsw xmm0, xmm1
  movq rax, xmm0
  mov word [rdi + %1], ax
%endmacro

%macro SubSaturated.mmu8x16 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpsubusb xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro SubSaturated.mmu8x32 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vpsubusb ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro SubSaturated.mms8x32 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vpsubsb ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro



; -----------------------------------------------------------------------------
; Round -- Round number to nearest integer
; x = round(a). x, a of the same type.

%macro Round.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  vroundps xmm0, xmm0, 0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Round.mf32x8 2
  vmovdqu ymm0, yword [rdi + %2]
  vroundps ymm0, ymm0, 0
  vmovdqu yword [rdi + %1], ymm0
%endmacro

; -----------------------------------------------------------------------------
; Floor -- Round down to nearest integer
; x = floor(a). x, a of the same type.

%macro Floor.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  vroundps xmm0, xmm0, 1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Ceil -- Round up to nearest integer
; x = ceil(a). x, a of the same type.

%macro Ceil.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  vroundps xmm0, xmm0, 2
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Truncate -- Round towards zero
; x = truncate(a). x, a of the same type.

%macro Truncate.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  vroundps xmm0, xmm0, 3
  movdqu oword [rdi + %1], xmm0
%endmacro




; -----------------------------------------------------------------------------
; Abs -- Absolute Value
; x = |a|. x, a of the same type.

; v0.1

%macro Abs.mu8 2
  mov al, byte [rdi + %2]
  mov byte [rdi + %1], al
%endmacro

%macro Abs.mu16 2
  mov ax, word [rdi + %2]
  mov word [rdi + %1], ax
%endmacro

%macro Abs.mu32 2
  mov eax, dword [rdi + %2]
  mov dword [rdi + %1], eax
%endmacro

%macro Abs.mu64 2
  mov rax, qword [rdi + %2]
  mov qword [rdi + %1], rax
%endmacro

%macro Abs.ms8 2
  mov al, byte [rdi + %2]
  mov cl, al
  neg al
  cmovl ax, cx
  mov byte [rdi + %2], al
%endmacro

%macro Abs.ms16 2
  mov ax, word [rdi + %2]
  mov cx, ax
  neg ax
  cmovl ax, cx
  mov word [rdi + %2], ax
%endmacro

%macro Abs.ms32 2
  mov eax, dword [rdi + %2]
  mov ecx, eax
  neg eax
  cmovl eax, ecx
  mov dword [rdi + %2], eax
%endmacro

%macro Abs.ms64 2
  mov rax, qword [rdi + %2]
  mov rcx, rax
  neg rax
  cmovl rax, rcx
  mov qword [rdi + %2], rax
%endmacro

%macro Abs.mf32 3
  mov eax, dword [rdi + %2]
	and eax, 0x7FFFFFFF
  mov dword [rdi + %1], eax
%endmacro

%macro Abs.mf64 3
  mov rdx, qword [rdi + %2]
  mov rax, 0x7FFFFFFFFFFFFFFF
	and rdx, rax
  mov qword [rdi + %1], rdx
%endmacro

%macro Abs.mu16x8 2
  movdqu xmm0, oword [rdi + %2]
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Abs.mu32x4 2
  movdqu xmm0, oword [rdi + %2]
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Abs.ms16x8 2
  movdqu xmm0, oword [rdi + %2]
  pabsw xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro


; Future

%macro Abs.ms8x16 2
  movdqu xmm0, oword [rdi + %2]
  pabsb xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Abs.ms32x4 2
  movdqu xmm0, oword [rdi + %2]
  pabsd xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Abs.ms64x2 2
  movdqu xmm0, oword [rdi + %2]
  pabsq xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro



