  vpcmpgtb ymm2, ymm0, ymm1
  vpcmpeqb ymm3, ymm3, ymm3
  vpxor ymm0, ymm2, ymm3
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Lte.rrru8x32 3
