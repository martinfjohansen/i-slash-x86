%macro Mov.iu8x16 2
  mov al, %2
  movzx rax, al
  movq xmm1, rax
  ;vpbroadcastb xmm0, xmm1
  pxor xmm0, xmm0
  vpshufb xmm0, xmm1, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Mov.mu8x16 2
  movdqu xmm0, oword [rdi + %2]
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Mov.mu32x4 2
  movdqu xmm0, oword [rdi + %2]
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Mov.iu16x8 2
  mov ax, %2
  movzx rax, ax
  movq xmm1, rax
  ;vpbroadcastw xmm0, xmm1
  pxor xmm0, xmm0
  vpshufw xmm0, xmm1, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Mov.iu32x4 2
  mov rax, %2
  movq xmm1, rax
  ;vpbroadcastd xmm0, xmm1
  vpshufd xmm0, xmm1, 0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Mov.iu64x2 2
  mov rax, %2
  movq xmm1, rax
  vpbroadcastq xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Mov.iu8x32 2
  mov rax, %2
  movq xmm2, rax
  vpbroadcastb ymm0, xmm2
  vmovdqu yword [rdi + %1], ymm0
%endmacro

; TODO: How to deal with Mov vs Broadcast and exp a?
%macro Mov.riu8x32 2
  mov rax, %2
  movq xmm2, rax
  vpbroadcastb %1, xmm2
%endmacro

%macro Mov.if32 2
  mov eax, __?float32?__(%2)
  mov dword [rdi + %1], eax
%endmacro

%macro Mov.if64 2
  mov rax, __?float64?__(%2)
  mov qword [rdi + %1], rax
%endmacro

%macro Mov.mf32 2
