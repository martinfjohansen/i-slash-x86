%endmacro

; -----------------------------------------------------------------------------
; Movx8
; x = 1:2:3:4:5:6:7:8

; v0.1

%macro Movx8.iiiiiiiiu16x8 9
  mov rax, %2 | %3 << 16 | %4 << 32 | %5 << 48
  movq xmm0, rax
  mov rax, %6 | %7 << 16 | %8 << 32 | %9 << 48
  pinsrq xmm0, rax, 1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Movx8.iiiiiiiis16x8 9
  mov rax, (%2 & 0xFFFF) | (%3 & 0xFFFF) << 16 | (%4 & 0xFFFF) << 32 | (%5 & 0xFFFF) << 48
  movq xmm0, rax
  mov rax, (%6 & 0xFFFF) | (%7 & 0xFFFF) << 16 | (%8 & 0xFFFF) << 32 | (%9 & 0xFFFF) << 48
  pinsrq xmm0, rax, 1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Movx8.iiiiiiiib16x8 9
  mov rax, %2 | %3 << 16 | %4 << 32 | %5 << 48
  movq xmm0, rax
  mov rax, %6 | %7 << 16 | %8 << 32 | %9 << 48
  pinsrq xmm0, rax, 1
  movdqu oword [rdi + %1], xmm0
%endmacro





; Future

%macro Movx8.iiiiiiiiu32x8 9
  mov rax, %2 | %3 << 32
  movq xmm0, rax
  mov rax, %4 | %5 << 32
  pinsrq xmm0, rax, 1
  mov rax, %6 | %7 << 32
  movq xmm1, rax
  mov rax, %8 | %9 << 32
  pinsrq xmm1, rax, 1
  vinserti128 ymm0, ymm0, xmm1, 1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

; -----------------------------------------------------------------------------
; Broadcast
; x = (AtoB)a.

%macro Broadcast.mu16x8 2
  vpbroadcastw xmm0, word [rdi + %2]
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Broadcast.ms16x8 2
  vpbroadcastw xmm0, word [rdi + %2]
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Broadcast.mu16x16 2
  vpbroadcastw ymm0, word [rdi + %2]
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Broadcast.mu16x32 2
  vpbroadcastw zmm0, word [rdi + %2]
  vmovdqu16 zword [rdi + %1], zmm0
%endmacro

; -----------------------------------------------------------------------------
; Loop
; No parameters

%macro Loop 1
  %1:
%endmacro

; -----------------------------------------------------------------------------
; Len
; x = len(a). x must be a number. a must be an array.

%macro Len 2
  mov rax, qword [rdi + %2]
  mov rax, qword [rax - 8]
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Lt
; x = a < b. x is a boolean. a and b are of the same type.

; v0.1

%macro Lt.mmb1u8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  cmp al, dl
  setb al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1u16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  cmp ax, dx
  setb al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1u32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  cmp eax, edx
  setb al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1u64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  cmp rax, rdx
  setb al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1s8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  cmp al, dl
  setl al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1s16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  cmp ax, dx
  setl al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1s32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  cmp eax, edx
  setl al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1s64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  cmp rax, rdx
  setl al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb1f32 3
  movss xmm0, [rdi + %2]
  movss xmm1, [rdi + %3]
  cmpltss xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Lt.mmb1f64 3
  movsd xmm0, [rdi + %2]
  movsd xmm1, [rdi + %3]
  cmpltsd xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Lt.mmb16x8s16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  pcmpgtw xmm1, xmm0
  movdqu oword [rdi + %1], xmm1
%endmacro

; Polyfill
; Lt.mmb16x8u16x8



; Future

%macro Lt.rrrb1u64 3
  cmp %2, %3
  setb %1
%endmacro

%macro Lt.iib1u16 3
  mov ax, %2
  mov dx, %3
  cmp ax, dx
  setb al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.iib1u64 3
