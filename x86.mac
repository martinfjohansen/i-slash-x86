%macro s16tos8.m 2
  ;pinsrw xmm0, word [rdi + %1], 0
  vpbroadcastw xmm0, word [rdi + %2]
  packsswb xmm0, xmm0
  pextrb byte [rdi + %1], xmm0, 0
%endmacro

%macro s32tos16.m 2
  ;pinsrd xmm0, dword [rdi + %1], 0
  vpbroadcastd xmm0, dword [rdi + %2]
  packssdw xmm0, xmm0
  pextrw word [rdi + %1], xmm0, 0
%endmacro

%macro u16tou8.m 2
  ;pinsrw xmm0, word [rdi + %1], 0
  vpbroadcastw xmm0, word [rdi + %2]
  packuswb xmm0, xmm0, xmm0
  pextrb byte [rdi + %1], xmm0, 0
%endmacro

%macro u32tou16.m 2
  ;pinsrd xmm0, dword [rdi + %1], 0
  vpbroadcastd xmm0, word [rdi + %2]
  packusdw xmm0, xmm0, xmm0
  pextrw word [rdi + %1], xmm0, 0
%endmacro

%macro u64tou32.m 2
  ;pinsrq xmm0, qword [rdi + %1], 0
  vpbroadcastq xmm0, qword [rdi + %2]
  vpmovusqd xmm0, xmm0
  pextrd dword [rdi + %1], xmm0, 0
%endmacro

%macro s64tos32.m 2
  ;pinsrq xmm0, qword [rdi + %1], 0
  vpbroadcastq xmm0, qword [rdi + %2]
  vpmovsqd xmm0, xmm0
  pextrd dword [rdi + %1], xmm0, 0
%endmacro

; Light polyfill

; Note: cmovl does not support moves to r8
%macro s8tou8.m 2
  mov al, byte [rdi + %2]
  cmp al, 0
  cmovl ax, 0
  mov byte [rdi + %1], al
%endmacro

%macro s16tou16.m 2
  mov ax, word [rdi + %2]
  cmp ax, 0
  cmovl ax, 0
  mov word [rdi + %1], ax
%endmacro

%macro s32tou32.m 2
  mov eax, dword [rdi + %2]
  cmp eax, 0
  cmovl eax, 0
  mov dword [rdi + %1], eax
%endmacro

%macro s64tou64.m 2
  mov rax, qword [rdi + %2]
  cmp rax, 0
  cmovl rax, 0
  mov qword [rdi + %1], rax
%endmacro

%macro u8tos8.m 2
  mov al, byte [rdi + %2]
  cmp al, 0x7F
  cmova ax, 0x7F
  mov byte [rdi + %1], al
%endmacro

%macro u16tos16.m 2
  mov ax, word [rdi + %2]
  cmp ax, 0x7FFF
  cmova ax, 0x7FFF
  mov word [rdi + %1], ax
%endmacro

%macro u32tos32.m 2
  mov eax, dword [rdi + %2]
  cmp eax, 0x7FFF_FFFF
  cmova eax, 0x7FFF_FFFF
  mov dword [rdi + %1], eax
%endmacro

; Note: Cmp does not support 64-bit immediate
%macro u64tos64.m 2
  mov rax, qword [rdi + %2]
  mov rcx, 0x7FFF_FFFF_FFFF_FFFF
  cmp rax, rcx
  cmova rax, rcx
  mov qword [rdi + %1], rax
%endmacro

%macro u8tos16.m 2
  mov al, byte [rdi + %2]
  movzx ax, al
  mov word [rdi + %1], ax
%endmacro

%macro u8tos32.m 2
  mov al, byte [rdi + %2]
  movzx eax, al
  mov dword [rdi + %1], eax
%endmacro

%macro u16tos32.m 2
  mov ax, word [rdi + %2]
  movzx eax, ax
  mov dword [rdi + %1], eax
%endmacro

%macro u32tos64.m 2
  mov eax, dword [rdi + %2]
  movzx rax, eax
  mov qword [rdi + %1], rax
%endmacro

%macro f32tof64.m 2
  movss xmm0, dword [rdi + %2]
  cvtss2sd xmm0, xmm0
  movsd [rdi + %1], xmm0
%endmacro

%macro f64tof32.m 2
  movsd xmm0, qword [rdi + %2]
  cvtsd2ss xmm0, xmm0
  movss dword [rdi + %1], xmm0
%endmacro

%macro f32tou32.m 2
  movss xmm0, [rdi + %2]
  cvttss2si eax, xmm0
  mov dword [rdi + %1], eax
%endmacro

%macro f32tos32.m 2
  movss xmm0, [rdi + %2]
  cvttss2si eax, xmm0
  mov dword [rdi + %1], eax
%endmacro

%macro f32tou64.m 2
  movss xmm0, [rdi + %2]
  cvttss2si rax, xmm0
  mov dword [rdi + %1], rax
%endmacro

%macro f32tos64.m 2
  movss xmm0, [rdi + %2]
  cvttss2si rax, xmm0
  mov qword [rdi + %1], rax
%endmacro

%macro f64tou64.m 2
  movsd xmm0, [rdi + %2]
  cvttsd2si rax, xmm0
  mov qword [rdi + %1], rax
%endmacro

%macro f64tos64.m 2
  movsd xmm0, [rdi + %2]
  cvttsd2si rax, xmm0
  mov qword [rdi + %1], rax
%endmacro

%macro s32tof32.m 2
  mov eax, dword [rdi + %2]
  cvtsi2ss xmm0, eax
  movsd [rdi + %1], xmm0
%endmacro

%macro s32tof64.m 2
  mov eax, dword [rdi + %2]
  cvtsi2sd xmm0, eax
  movsq [rdi + %1], xmm0
%endmacro

%macro s64tof32.m 2
  mov rax, qword [rdi + %2]
  cvtsi2ss xmm0, rax
  movsd [rdi + %1], xmm0
%endmacro

%macro s64tof64.m 2
