  mov rdx, %3
  cmp rax, rdx
  setb al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.iib1s16 3
  mov ax, %2
  mov dx, %3
  cmp ax, dx
  setl al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mib8x32u8x32 3
  vmovdqu ymm0, yword [rdi + %2]
  mov rax, %3
  movq xmm2, rax
  vpbroadcastb ymm1, xmm2
  vpcmpgtb ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Lt.mmb8x32s8x16 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpcmpgtb xmm0, xmm1, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Lt.mib1f64 3
  movsd xmm0, [rdi + %2]
  mov rax, __?float64?__(%3)
  movq xmm1, rax
  cmpltsd xmm0, xmm1
  movq rax, xmm0
  cmp al, 255
  sete [rdi + %1]
%endmacro

%macro Lt.mib1s64 3
  mov rax, qword [rdi + %2]
  mov rdx, %3
  cmp rax, rdx
  setl al
  mov byte [rdi + %1], al
%endmacro

%macro Lt.mmb32x4f32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vcmpltps xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

