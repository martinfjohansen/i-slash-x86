  vmovdqu16 zmm1, zword [rdi + %3]
  vpcmpeqw k1, zmm0, zmm1
  vpmovm2w zmm0, k1
  vmovdqu16 zword [rdi + %1], zmm0
%endmacro

%macro Eq.mmm32u16x32 3
  vmovdqu16 zmm0, zword [rdi + %2]
  vmovdqu16 zmm1, zword [rdi + %3]
  vpcmpeqw k1, zmm0, zmm1
  kmovd dword [rdi + %1], k1
%endmacro

