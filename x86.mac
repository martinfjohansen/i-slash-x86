; Integer
; Working registers -- rax, rcx, rdx
; Parameter: rdi
; Unused: rbx, rsi, r8-r15
; Linux:
;  - Caller saves: rax, rcx, rdx, rsi, rdi, r8-r11
;  - Callee saves: rbx, rsp, rbp, r12-r15
; Windows:
;  - Caller saves: rax, rcx, rdx, r8-r11, xmm0–xmm5
;  - Callee saves: rbx, rbp, rsi, rdi, r12-r15, xmm6–xmm15

; SSE
; Working registers -- xmm0, xmm1, xmm2
; Unused: xmm3-xmm15 (31)

; AVX
; Working registers -- ymm0, ymm1, ymm2, ymm3
; Unused: ymm4-ymm15 (31)

; AVX-512
; Working registers -- zmm0, zmm1, zmm2, zmm3, k0, k1, k2
; Unused: zmm4-zmm31, k3-k7

; The use of pointers for arrays and structures might be OK. The memory can be made nicely contigous by using a suitable allocator to initialize static structures and arrays.

; -----------------------------------------------------------------------------

%assign true 1
%assign false 0

; -----------------------------------------------------------------------------
; Add
; x = a + b. x, a, b of the same type.

; v0.1

%macro Add.mmu8 3
  mov al, byte [rdi + %2]
  mov cl, byte [rdi + %3]
  add al, cl
  mov byte [rdi + %1], al
%endmacro

%macro Add.mmu16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  add ax, dx
  mov word [rdi + %1], ax
%endmacro

%macro Add.mmu32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  add eax, edx
  mov dword [rdi + %1], eax
%endmacro

%macro Add.mmu64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  add rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Add.mms8 3
  mov al, byte [rdi + %2]
  mov cl, byte [rdi + %3]
  add al, cl
  mov byte [rdi + %1], al
%endmacro

%macro Add.mms16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  add ax, dx
  mov word [rdi + %1], ax
%endmacro

%macro Add.mms32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  add eax, edx
  mov dword [rdi + %1], eax
%endmacro

%macro Add.mms64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  add rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Add.mmf32 3
  movss xmm0, dword [rdi + %2]
  addss xmm0, dword [rdi + %3]
  movss dword [rdi + %1], xmm0
%endmacro

%macro Add.mmf64 3
  movsd xmm0, qword [rdi + %2]
  addsd xmm0, qword [rdi + %3]
  movsd qword [rdi + %1], xmm0
%endmacro

%macro Add.mmu16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  paddw xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Add.mms16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  paddw xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro




; Future

%macro Add.miu16 3
  mov ax, word [rdi + %2]
  mov dx, %3
  add ax, dx
  mov word [rdi + %1], ax
%endmacro

%macro Add.miu64 3
  mov rax, qword [rdi + %2]
  mov rdx, %3
  add rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Add.mis64 3
  mov rax, qword [rdi + %2]
  mov rdx, %3
  add rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Add.rrru64 3
  mov rax, %2
  add rax, %3
  mov %1, rax
%endmacro

%macro Add.miu8x32 3
  vmovdqu ymm0, yword [rdi + %2]
  mov rax, %3
  movq xmm2, rax
  vpbroadcastb ymm1, xmm2
  vpaddb ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Add.mmu8x32 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vpaddb ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Add.mmu32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpaddd xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Add.mmu8x16 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpaddb xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Add.mmf32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vaddps xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Add.mmf32x8 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vaddps ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Add.mmf64x8 3
  vmovdqu64 zmm0, zword [rdi + %2]
  vmovdqu64 zmm1, zword [rdi + %3]
  vaddpd zmm0, zmm0, zmm1
  vmovdqu64 zword [rdi + %1], zmm0
%endmacro

%macro Add.mmf32x16 3
  vmovdqu32 zmm0, zword [rdi + %2]
  vmovdqu32 zmm1, zword [rdi + %3]
  vaddps zmm0, zmm0, zmm1
  vmovdqu32 zword [rdi + %1], zmm0
%endmacro

; -----------------------------------------------------------------------------
; Sub
; x = a - b. a, b, c of the same type.

%macro Sub.mmu8 3
  mov al, byte [rdi + %2]
  mov cl, byte [rdi + %3]
  sub al, cl
  mov byte [rdi + %1], al
%endmacro

%macro Sub.mmu16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  sub ax, dx
  mov word [rdi + %1], ax
%endmacro

%macro Sub.mmu64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  sub rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Sub.mms64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  sub rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Sub.mis64 3
  mov rax, qword [rdi + %2]
  mov rdx, %3
  sub rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Sub.miu64 3
  mov rax, qword [rdi + %2]
  mov rdx, %3
  sub rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Sub.imu64 3
  mov rax, %2
  mov rdx, qword [rdi + %3]
  sub rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Sub.rrru64 3
  mov rax, %2
  sub rax, %3
  mov %1, rax
%endmacro

%macro Sub.mmf64 3
  movsd xmm0, [rdi + %2]
  subsd xmm0, [rdi + %3]
  movsd [rdi + %1], xmm0
%endmacro

%macro Sub.mmu8x32 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vpsubb ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Sub.mmu32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpsubd xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Sub.rrru8x32 3
  vpsubb %1, %2, %3
%endmacro

%macro Sub.miu8x32 3
  vmovdqu ymm0, yword [rdi + %2]
  mov rax, %3
  movq xmm2, rax
  vpbroadcastb ymm1, xmm2
  vpsubb ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

%macro Sub.mmf32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vsubps xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Sub.mmf32x8 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vsubps ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

; -----------------------------------------------------------------------------
; Mul
; x = a * b. a, b, c of the same type.

; v0.1

%macro Mul.mmu8 3
  mov al, byte [rdi + %2]
  mov cl, byte [rdi + %3]
  mul cl
  mov byte [rdi + %1], al
%endmacro

%macro Mul.mmu16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  mul dx
  mov word [rdi + %1], ax
%endmacro

%macro Mul.mmu32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  mul edx
  mov dword [rdi + %1], eax
%endmacro

%macro Mul.mmu64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  mul rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Mul.mms8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  imul dl
  mov byte [rdi + %1], al
%endmacro

%macro Mul.mms16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  imul ax, dx
  mov word [rdi + %1], ax
%endmacro

%macro Mul.mms32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  imul eax, edx
  mov dword [rdi + %1], eax
%endmacro

%macro Mul.mms64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  imul rax, rdx
  mov qword [rdi + %1], rax
%endmacro

%macro Mul.mmf32 3
  movd xmm0, dword [rdi + %2]
  movd xmm1, dword [rdi + %3]
  mulss xmm0, xmm1
  movd dword [rdi + %1], xmm0
%endmacro

%macro Mul.mmf64 3
  movsd xmm0, [rdi + %2]
  mulsd xmm0, [rdi + %3]
  movsd [rdi + %1], xmm0
%endmacro

%macro Mul.mms16x8 3
