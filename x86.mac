; -----------------------------------------------------------------------------
; Signed integer to smaller signed type with saturation
; u32tou16s
; x = (AtoB)a. a must be of type A, x must be of type B.

%macro u32tou16s.m 2
  mov rax, 0
  mov eax, dword [rdi + %2]
  movq xmm0, rax
  packusdw xmm0, xmm0
  movq rax, xmm0
  mov word [rdi + %1], ax
%endmacro

%macro s32tos16s.m 2
  mov rax, 0
  mov eax, dword [rdi + %2]
  movq xmm0, rax
  packssdw xmm0, xmm0
  movq rax, xmm0
  mov word [rdi + %1], ax
%endmacro


; -----------------------------------------------------------------------------
; Ror
; x = a op b. x, a must be bitfield types. b must be a number.

%macro Ror.mib32 3
  mov eax, dword [rdi + %2]
  ror eax, %3
  mov dword [rdi + %1], eax
%endmacro

%macro Ror.mib64 3
  mov rax, qword [rdi + %2]
  ror rax, %3
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Rol
; x = a op b. x, a must be bitfield types. b must be a number.

%macro Rol.mib32 3
  mov eax, dword [rdi + %2]
  rol eax, %3
  mov dword [rdi + %1], rax
%endmacro

%macro Rol.mib64 3
  mov rax, qword [rdi + %2]
  rol rax, %3
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; IsZero
; x = a = 0. x can be bit or number. a must be a boolean.

%macro IsZero.mb32 2
  mov eax, dword [rdi + %2]
  test eax, eax
  setz al
  mov byte [rdi + %1], al
%endmacro

; -----------------------------------------------------------------------------
; IsNonZero
; x = a != 0. x can be bit or number. a must be a boolean.

%macro IsNonZero.mb32 2
  mov eax, dword [rdi + %2]
  test eax, eax
  setnz al
  mov byte [rdi + %1], al
%endmacro

; -----------------------------------------------------------------------------
; Cmov
; x = a ? b : x. x, b must be the same types. a must be a boolean.

%macro Cmov.mms64 3
  mov rdx, qword [rdi + %2]
  mov al, byte [rdi + %3]
  test al, al
  cmovnz rax, rdx
  mov qword [rdi + %1], rax
%endmacro

; Cmovcc
; x = (a op b) ? b : x. x, b must be the same types. a and b must be the same types or number types.
; op can be 'a', 'ae', 'b', 'be', 'c', 'e', 'g', 'ge', 'l', 'le', 'na', 'nae', 'nb', 'nbe', 'nc', 'ne', 'ng', 'nge', 'nl', 'nle', 'no', 'np', 'ns', 'nz', 'o', 'p', 'pe', 'po', 's', 'z'
; Comparizons: 'e', 'ne', 'g', 'ge', 'l', 'le'
; Arithmetic: 'z', 'o', 's', 'p'

%macro Cmoveq.mms64 4
  mov rax, qword [rdi + %3]
  mov rdx, qword [rdi + %4]
  mov rcx, qword [rdi + %2]
  cmp rax, rdx
  cmovz rax, rcx
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Xchg
; a op b. a and b must be the same types.

%macro Xchg.ms64 2
  mov rax, qword [rdi + %2]
  xchg rax, qword [rdi + %1]
  mov qword [rdi + %2], rax
%endmacro

; -----------------------------------------------------------------------------
; Xadd
; In one go: a' = a + b; b' = a

%macro Xadd.ms64 2
  mov rax, qword [rdi + %2]
  xadd qword [rdi + %1], rax
  mov qword [rdi + %2], rax
%endmacro

; -----------------------------------------------------------------------------
; Bswap
; x = bswap(a). a and x must be bitfields.

%macro Bswap.mb64 2
  mov rax, qword [rdi + %2]
  bswap rax
  mov qword [rdi + %1], rax
%endmacro

%macro Bswap.mb32 2
  mov eax, dword [rdi + %2]
  bswap eax
  mov dword [rdi + %1], eax
%endmacro

%macro Bswap.mb16 2
  mov ax, word [rdi + %2]
  xchg ah, al
  mov word [rdi + %1], ax
%endmacro

; -----------------------------------------------------------------------------
; Bsf -- Bit scan forward, find first set bit rightwards
; x = Bsf(a). a must be a bitfield. x is a number.

%macro Bsf.mb64 2
  mov rax, qword [rdi + %2]
  bsf rax, rax
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Bsr -- Bit scan reverse, find first set bit leftwards
; x = Bsr(a). a must be a bitfield. x is a number.

%macro Bsr.mb64 2
  mov rax, qword [rdi + %2]
  bsr rax, rax
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Bt -- Bit test
; x = Bt(a). a must be a bitfield. x is a boolean.

%macro Bt.miu64 3
  mov rax, qword [rdi + %2]
  bt rax, %3
  setc al
  movzx rax, al
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; CmpXchg -- Compare and Exchange
; x = (a == b) ? (b = c, 1) : (a = b, 0)

%macro CmpXchg.mms64 4
  mov rax, qword [rdi + %2]
  mov rcx, qword [rdi + %3]
  mov rdx, qword [rdi + %4]
  cmpxchg rcx, rdx
  setz r8b
  mov byte [rdi + %1], r8b
  mov qword [rdi + %2], rax
  mov qword [rdi + %3], rcx
%endmacro

; -----------------------------------------------------------------------------
; Crc32 -- Cyclic redundancy check
; x = crc32(a)

%macro Crc32.mu32 2
  mov eax, dword [rdi + %1]
  mov ecx, dword [rdi + %2]
  crc32 eax, ecx
  mov dword [rdi + %1], eax
%endmacro

; -----------------------------------------------------------------------------
; Movs -- Move String, Block copy
; x = Movs(a, len). a and x must be arrays, len must be a number.

%macro Movs.mmu8a 3
  cld
  mov rsi, qword [rdi + %2]
  mov rcx, qword [rdi + %3]
  mov rbx, rdi
  mov rdi, qword [rdi + %1]
  rep movsb
  mov rdi, rbx
%endmacro

%macro Movs.mmu16a 3
  cld
  mov rsi, qword [rdi + %2]
  mov rcx, qword [rdi + %3]
  mov rbx, rdi
  mov rdi, qword [rdi + %1]
  rep movsw
  mov rdi, rbx
%endmacro

%macro Movs.mmu32a 3
  cld
  mov rsi, qword [rdi + %2]
  mov rcx, qword [rdi + %3]
  mov rbx, rdi
  mov rdi, qword [rdi + %1]
  rep movsd
  mov rdi, rbx
%endmacro

%macro Movs.mmu64a 3
  cld
  mov rsi, qword [rdi + %2]
  mov rcx, qword [rdi + %3]
  mov rbx, rdi
  mov rdi, qword [rdi + %1]
  rep movsq
  mov rdi, rbx
%endmacro

; -----------------------------------------------------------------------------
; Cmps -- Compare strings
; x = Cmps(a, b, len). a, b must be arrays, len must be a number, x must be a boolean.

%macro Cmps.mmu8a 4
  cld
  mov rsi, qword [rdi + %3]
  mov rcx, qword [rdi + %4]
  mov rbx, rdi
  mov rdi, qword [rdi + %2]
  rep cmpsb
  mov rdi, rbx
  setz byte [rdi + %1]
%endmacro

%macro Cmps.mmu16a 4
  cld
  mov rsi, qword [rdi + %3]
  mov rcx, qword [rdi + %4]
  mov rbx, rdi
  mov rdi, qword [rdi + %2]
  rep cmpsw
  mov rdi, rbx
  setz byte [rdi + %1]
%endmacro

%macro Cmps.mmu32a 4
  cld
  mov rsi, qword [rdi + %3]
  mov rcx, qword [rdi + %4]
  mov rbx, rdi
  mov rdi, qword [rdi + %2]
  rep cmpsd
  mov rdi, rbx
  setz byte [rdi + %1]
%endmacro

%macro Cmps.mmu64a 4
  cld
  mov rsi, qword [rdi + %3]
  mov rcx, qword [rdi + %4]
  mov rbx, rdi
  mov rdi, qword [rdi + %2]
  rep cmpsq
  mov rdi, rbx
  setz byte [rdi + %1]
%endmacro

; -----------------------------------------------------------------------------
; Scas -- Block scan, find index of byte %3 in array %2
; x = Scas(a, c, len). a must be an array, c a character, len must be a number, x must be a number.

%macro Scas.mmu8a 4
  cld
  mov al, byte [rdi + %3]
  mov rcx, qword [rdi + %4]
  mov rbx, rdi
  mov rdi, qword [rdi + %2]
  repne scasb
  sete r8b
  movzx r8, r8b
  mov rdi, rbx
  sub rcx, qword [rdi + %4]
  neg rcx
  sub rcx, r8
  mov qword [rdi + %1], rcx
%endmacro

; -----------------------------------------------------------------------------
; Popcnt -- Population count -- count ones set
; x = Popcnt(a). a is a bitfield, x a number.

%macro Popcnt.mb64 2
  mov rax, qword [rdi + %2]
  popcnt rax, rax
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Lzcnt -- Leading zero count
; x = Lzcnt(a). a is a bitfield, x a number.

%macro Lzcnt.mu64b64 2
  mov rax, qword [rdi + %2]
  lzcnt rax, rax
  mov qword [rdi + %1], rax
%endmacro

%macro Lzcnt.mu64b32 2
  mov rax, 0
  mov eax, dword [rdi + %2]
  lzcnt rax, rax
  sub rax, 32
  mov qword [rdi + %1], rax
%endmacro

%macro Lzcnt.mu64b16 2
  mov rax, 0
  mov ax, word [rdi + %2]
  lzcnt rax, rax
  sub rax, 48
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Tzcnt -- Trailing zero count
; x = Tzcnt(a). a is a bitfield, x a number.

%macro Tzcnt.mb64 2
  mov rax, qword [rdi + %2]
  tzcnt rax, rax
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Rdtsc -- Read time stamp counter
; x = Rdtsc(). x is a number.

%macro Rdtsc.mu64 1
  rdtsc
  shl rdx, 32
  or rax, rdx
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Rdpmc -- Read performance counter
; x = Rdpmc(a). x, a is a number.

%macro Rdpmc.mu64 2
  mov rcx, qword [rdi + %2]
  rdpmc
  shl rdx, 32
  or rax, rdx
  mov qword [rdi + %1], rax
%endmacro

; -----------------------------------------------------------------------------
; Nop -- No operation
; No parameters

%macro Nop 0
  nop
%endmacro

; -----------------------------------------------------------------------------
; Bextr -- Bitfield extract -- dest = bits a length b from src
; x = Bextr(a, b, c). x, a are bitfields. b and c are numbers.

%macro Bextr.mmb64 4
  mov rax, 0
  mov al, byte [rdi + %3]
  mov ah, byte [rdi + %4]
  mov rcx, qword [rdi + %2]
  bextr rdx, rcx, rax
  mov qword [rdi + %1], rdx
%endmacro

; -----------------------------------------------------------------------------
; Blsi -- Extract Lowest Set Isolated Bit
; x = Blsi(a). a are bitfields. x is a number.

%macro Blsi.mb64 2
  mov rax, qword [rdi + %2]
  blsi rdx, rax
  mov qword [rdi + %1], rdx
%endmacro

; -----------------------------------------------------------------------------
; Blsmsk -- Generate bitmask
; x = Blsmsk(a). x, a are bitfields.

%macro Blsmsk.mb64 2
  mov rax, qword [rdi + %2]
  blsmsk rdx, rax
  mov qword [rdi + %1], rdx
%endmacro

; -----------------------------------------------------------------------------
; Blsr -- Clear lowest bit set
; x = Blsr(a). x, a are bitfields.

%macro Blsr.mb64 2
  mov rax, qword [rdi + %2]
  blsr rdx, rax
  mov qword [rdi + %1], rdx
%endmacro

; -----------------------------------------------------------------------------
; Bzhi -- Clear high order bits
; x = Bzhi(a). x, a are bitfields.

%macro Bzhi.mmb64 3
  mov rax, 0
  mov al, byte [rdi + %3]
  mov rdx, qword [rdi + %2]
  bzhi rcx, rdx, rax
  mov qword [rdi + %1], rcx
%endmacro

; -----------------------------------------------------------------------------
; Pdep -- Parallel bit deposit
; x = Pdep(a, b). x, a, b are bitfields.

%macro Pdep.mmb64 3
  mov rdx, qword [rdi + %2]
  mov rax, qword [rdi + %3]
  pdep rcx, rdx, rax
  mov qword [rdi + %1], rcx
%endmacro

; -----------------------------------------------------------------------------
; Pext -- Parallel bit extract
; x = Pext(a, b). x, a, b are bitfields.

%macro Pext.mmb64 3
  mov rdx, qword [rdi + %2]
  mov rax, qword [rdi + %3]
  pext rcx, rdx, rax
  mov qword [rdi + %1], rcx
%endmacro

; -----------------------------------------------------------------------------
; ExtractMask -- Extract Byte Mask
; x = ExtractMask(a). a is an 8xX-bit, x is X-bit

%macro ExtractMask.mb8x16 2
  movdqu xmm1, oword [rdi + %2]
  pmovmskb eax, xmm1
  mov word [rdi + %1], ax
%endmacro

%macro ExtractMask.mb8x32 2
  vmovdqu ymm0, yword [rdi + %2]
  vpmovmskb rax, ymm0
  mov dword [rdi + %1], eax
%endmacro

;%macro ExtractMask.mu16x8 2
;  movdqu xmm1, oword [rdi + %2]
;  pmovmskb eax, xmm1
;  mov dword [rdi + %1], eax
;%endmacro

%macro ExtractMask.mb8x64 2
  vmovdqu8 zmm0, zword [rdi + %2]
  vpmovb2m k1, zmm0
  kmovq qword [rdi + %1], k1
%endmacro


; -----------------------------------------------------------------------------
; Shuffle -- Shuffle data
; x = Shuffle(a, b). a, b, x are the same packed number type.

%macro Shuffle.mmu8x16 3
  movdqu xmm0, oword [rdi + %1]
  movdqu xmm1, oword [rdi + %2]
  movdqu xmm2, oword [rdi + %3]
  vpshufb xmm0, xmm1, xmm2
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro Shuffle.miu32x4 6
  movdqu xmm0, oword [rdi + %1]
  movdqu xmm1, oword [rdi + %2]
  vpshufd xmm0, xmm1, (%3<<6)|(%4<<4)|(%5<<2)|(%6<<0)
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; MulStoreHigh -- Multiply Store high
; x = MulStoreHigh(a, b). a, b, x are the same number type.

%macro MulStoreHigh.mmu16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  vpmulhuw xmm0, xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro MulStoreHigh.mmu16x16 3
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vpmulhuw ymm0, ymm0, ymm1
  vmovdqu yword [rdi + %1], ymm0
%endmacro

; -----------------------------------------------------------------------------
; SelectiveCopy -- Conditionally copy from one SIMD register to another
; x = SelectiveCopy(a, b, c). a, b, c, x are the same packed number types.

%macro SelectiveCopy.mmu8x16 4
  movdqu xmm1, oword [rdi + %2]
  movdqu xmm2, oword [rdi + %3]
  movdqu xmm0, oword [rdi + %4]
  pblendvb xmm1, xmm2
  movdqu oword [rdi + %1], xmm1
%endmacro

%macro SelectiveCopy.mmu8x32 4
  vmovdqu ymm0, yword [rdi + %2]
  vmovdqu ymm1, yword [rdi + %3]
  vmovdqu ymm2, yword [rdi + %4]
  vpblendvb ymm0, ymm0, ymm1, ymm2
  vmovdqu yword [rdi + %1], ymm0
%endmacro

; -----------------------------------------------------------------------------
; MultiplyAndAdd -- Fused Multiply and add
; x = MultiplyAndAdd(a, b, c). a, b, c, x are the same packed number types.

%macro MultiplyAndAdd.mmf32x4 4
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  movdqu xmm2, oword [rdi + %4]
  vfmadd123ps xmm0, xmm1, xmm2
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
