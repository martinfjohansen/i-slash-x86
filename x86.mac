  vcmpeqps xmm0, xmm1, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Neq -- Not equal
; x = a != b. x is a boolean. a and b are the same types.

; v0.1

%macro Neq.mmb1u8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  cmp al, dl
  setne al
  mov byte [rdi + %1], al
%endmacro

%macro Neq.mmb1u16 3
  mov ax, word [rdi + %2]
  mov dx, word [rdi + %3]
  cmp ax, dx
  setne al
  mov byte [rdi + %1], al
%endmacro

%macro Neq.mmb1u32 3
  mov eax, dword [rdi + %2]
  mov edx, dword [rdi + %3]
  cmp eax, edx
  setne al
  mov byte [rdi + %1], al
%endmacro

%macro Neq.mmb1u64 3
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  cmp rax, rdx
  setne al
  mov byte [rdi + %1], al
%endmacro

%macro Neq.mmb1s8 3
  mov al, byte [rdi + %2]
  mov dl, byte [rdi + %3]
  cmp al, dl
  setne al
  mov byte [rdi + %1], al
%endmacro

%macro Neq.mmb1s16 3
