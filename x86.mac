; -----------------------------------------------------------------------------
; Idro -- Index Read Array with offset
; x = a[b + c]. b and c must be numbers. a must be an array. x must be of the same type as the array's elements.

; v0.1

%macro Idro.mmiu8a 4
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
  mov al, byte [rax + rdx * 1 + %4 * 1]
  mov byte [rdi + %1], al
%endmacro

%macro Idro.mmiu16a 4
  mov rax, qword [rdi + %2]
  mov rdx, qword [rdi + %3]
