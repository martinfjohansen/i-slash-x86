; -----------------------------------------------------------------------------
; Sqrt -- Square root
; x = Sqrt(a). a, x are the same number types.

; v0.1

%macro Sqrt.mf32 2
  movd xmm0, dword [rdi + %2]
  sqrtss xmm0, xmm0
  movd dword [rdi + %1], xmm0
%endmacro

%macro Sqrt.mf64 2
  movq xmm0, qword [rdi + %2]
  sqrtsd xmm0, xmm0
  movq qword [rdi + %1], xmm0
%endmacro




; Future


%macro Sqrt.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  sqrtps xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; ApproxReciprocal -- x = approx(1 / a)
; x = ApproxReciprocal(a). a, x are the same number types.

%macro ApproxReciprocal.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  rcpps xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; ApproxReciprocalSqrt -- x = approx(1 / sqrt(a))
; x = ApproxReciprocalSqrt(a). a, x are the same number types.

%macro ApproxReciprocalSqrt.mf32x4 2
  movdqu xmm0, oword [rdi + %2]
  rsqrtps xmm0, xmm0
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; InterleaveLow -- Interleaves pairs from low data from both vectors
; x = InterleaveLow(a, b). a, b, x are the same packed number types.

%macro InterleaveLow.mmu32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  punpckldq xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; InterleaveHigh -- Interleaves pairs from high data from both vectors
; x = InterleaveLow(a, b). a, b, x are the same packed number types.

%macro InterleaveHigh.mmu32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  punpckhdq xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; CombineExtract -- Combine and extract a part offset by a constant
; x = CombineExtract(a, b. c). a, b are bitfields, c is a number.

%macro CombineExtract.mmiu8x16 4
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  palignr xmm0, xmm1, %4
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; Gather -- Gather data into array
; x = CombineExtract(p, a, b). p is a pointer. x, a and b are packed number types.

%macro Gather.mmmu32x4 4
  mov rax, qword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  movdqu xmm2, oword [rdi + %4]
  vpgatherdd xmm0, [rax + xmm1 * 4], xmm2
  movdqu oword [rdi + %1], xmm0
%endmacro


; -----------------------------------------------------------------------------
; SumAbsoluteDifference -- Sum of absolute differences
; x = SumAbsoluteDifference(a, b). a, b, x are packed number types.

%macro SumAbsoluteDifference.mmu8x16 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  psadbw xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; PairwiseAdd -- Pairwiser horizontal add
; x = PairwiseAdd(a, b). a, b, x are packed number types.

%macro PairwiseAdd.mms16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  phaddw xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; PairwiseSub -- Pairwiser horizontal subtract
; x = PairwiseSub(a, b). a, b, x are packed number types.

%macro PairwiseSub.mms16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  phsubw xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; PairwiseMulAdd -- Multiply vertical pairs and add horizontally
; x = PairwiseMulAdd(a, b). a, b, x are packed number types.

%macro PairwiseMulAdd.mms16x8 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  pmaddwd xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; AlternatingSubAdd -- Alternating subtract and add
; x = AlternatingSubAdd(a, b). a, b, x are packed number types.

%macro AlternatingSubAdd.mmf32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  addsubps xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; ConditionalNegate -- Conditionally nagate
; x = ConditionalNegate(a, b). a, b, x are packed number types.

%macro ConditionalNegate.mms32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  psignd xmm0, xmm1
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; DotProduct -- Dot Product
; x = a ⋅ b -- All parameters are the same multiple type.

%macro DotProduct.mmf32x4 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  dpps xmm0, xmm1, 0b1111_1111
  movdqu oword [rdi + %1], xmm0
%endmacro

%macro DotProduct.mmf64x2 3
  movdqu xmm0, oword [rdi + %2]
  movdqu xmm1, oword [rdi + %3]
  dppd xmm0, xmm1, 0b0011_0011
  movdqu oword [rdi + %1], xmm0
%endmacro

; -----------------------------------------------------------------------------
; StringSubset -- Identify the occurance of characters in a string
; x = StringSubset(a, b, l). x, a, b are packed bytes. l is a number.

%macro StringSubset.mmmiu8x16 5
  movdqu xmm1, oword [rdi + %3]
  mov rax, qword [rdi + %4]
  movdqu xmm2, oword [rdi + %2]
  mov rdx, %5
  pcmpestrm xmm1, xmm2, (0 << 6) + (0 << 2)
  vpextrw eax, xmm0, 0
  mov word [rdi + %1], ax
%endmacro

